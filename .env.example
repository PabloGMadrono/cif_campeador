# Surya llama.cpp runtime. CPU is the default.
SURYA_LLAMA_DEVICE=cpu
LLAMA_CPP_CPU_BINARY=C:\Tools\llama.cpp-cpu\llama-server.exe
LLAMA_CPP_CUDA_BINARY=C:\Tools\llama.cpp-cuda\llama-server.exe

# Optional API-backed OCR implementations.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# User-defined token for Meta's one-time WhatsApp webhook verification.
WHATSAPP_VERIFY_TOKEN=my_super_secret_verify_token
# Meta token with permission to retrieve inbound WhatsApp media.
WHATSAPP_ACCESS_TOKEN=
# Legacy local attachments only; relative paths resolve from the repository root.
WHATSAPP_MEDIA_DIR=tests/whatsapp_images
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_MEDIA_ALLOWED_HOSTS=lookaside.fbsbx.com
WHATSAPP_MEDIA_TIMEOUT_SECONDS=30
WHATSAPP_MEDIA_MAX_BYTES=104857600

# Local Docker MinIO. Replace these development credentials before deployment.
# Root credentials are used only by Compose provisioning, never by workers.
MINIO_ROOT_USER=campeador-admin
MINIO_ROOT_PASSWORD=local-admin-change-me
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=campeador-media
MINIO_SECRET_KEY=local-media-change-me
MINIO_SECURE=false
MINIO_BUCKET=invoice-originals
MINIO_REGION=us-east-1
MINIO_CONNECT_TIMEOUT_SECONDS=5
MINIO_READ_TIMEOUT_SECONDS=30

# SQL database and Redis Streams workers.
DATABASE_URL=sqlite:///./local_database/cif_campeador.db
REDIS_URL=redis://localhost:6379/0
DOWNLOAD_CONCURRENCY=20
DOWNLOAD_MAX_ATTEMPTS=3
OCR_CONCURRENCY=1
OCR_MAX_ATTEMPTS=3
QUEUE_RETRY_DELAYS_SECONDS=1,5
DOWNLOAD_CLAIM_IDLE_MS=300000
OCR_CLAIM_IDLE_MS=1800000
REDIS_DEAD_LETTER_MAX_ENTRIES=10000
REDIS_DEAD_LETTER_RETENTION_DAYS=30

# Shared local preprocessing. Keep off until diagnostic crops pass review.
# Modes: off, orientation (right-angle correction), full (crop/perspective/orient/deskew).
OCR_PREPROCESSING=full
OCR_PDF_DPI=300
OCR_BOUNDARY_ALLOWANCE=0.04
# Optional: OCR_PREPROCESSING_MODELS and OCR_PREPROCESSING_CACHE directories.

# Local configuration and secrets (keep shareable examples)
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Python virtual environments and bytecode
.venv/
venv/
env/
__pycache__/
*.py[cod]

# Python build and packaging output
/build/
/dist/
*.egg-info/
.eggs/

# Test, coverage, and static analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Downloaded llama.cpp runtime and release archives
/.llama_cpp/
/.ocr_preprocessing/
/.preprocessing-runtime/
/llama-*-bin-*.zip

# Generated OCR reports are ignored by tests/results/.gitignore

# Local logs, notebook checkpoints, and editor temporary files
*.log
.ipynb_checkpoints/
*.swp
*.swo
*~

# Operating system metadata
.DS_Store
Thumbs.db
Desktop.ini
